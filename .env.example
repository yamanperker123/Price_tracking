# Copy this file to .env and fill in your own values. Never commit .env!

# "console" prints messages to the terminal, "twilio" sends real SMS
NOTIFIER=console

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# How often to check the price (seconds)
CHECK_INTERVAL_SECONDS=300

# SQLite database file
DB_PATH=data/gold_tracker.db

# Price feed settings (defaults work out of the box)
PRICE_SOURCE_URL=https://finans.truncgil.com/v4/today.json
GOLD_SYMBOL=GRA
PRICE_FIELD=Selling
